{
  "expo": {
    "name": "د قرآن کریم پښتو او دري ترجمه",
    "slug": "quran-with-dari-and-pashto-translation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stoone.quran"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stoone.quran"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 8,
          "resizeMode": "contain",
          "backgroundColor": "#1a1a1a",
          "dark": {
            "image": "./assets/images/splash-blank.png",
            "backgroundColor": "#1a1a1a"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Your location is used to calculate prayer times and the Qibla direction. It never leaves your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#c0c4ca"
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "assets/db/app.db"
          ]
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55364ac1-2b13-4bcc-bd8a-9a8907b38476"
      }
    },
    "owner": "ahmadullahs-organization",
    "backgroundColor": "#f6f3e9"
  }
}
